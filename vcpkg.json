    "native-video": {
      "description": "Optional native video extension codecs",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swscale",
            "zlib"
          ]
        }
      ]
