+// Read only the requested slice; never materialize an entire extent for 4 KiB I/O.
+class PayloadReader {
+public:
+	explicit PayloadReader(sqlite3 *db) : db(db) {
+	}
+	~PayloadReader() {
+		sqlite3_blob_close(blob);
+	}
+	PayloadReader(const PayloadReader &) = delete;
+	PayloadReader &operator=(const PayloadReader &) = delete;
+	void Read(int64_t id, int64_t block_offset, int source_offset, int amount, char *target) {
+		if (!blob || current != id) {
+			int rc = blob ? sqlite3_blob_reopen(blob, id)
+			              : sqlite3_blob_open(db, "main", "block_payloads", "data", id, 0, &blob);
+			if (rc == SQLITE_ERROR)
+				Fail(ErrorCode::Storage, "Missing block payload");
+			Check(db, rc);
+			current = id;
+		}
+		auto size = sqlite3_blob_bytes(blob);
+		if (size < BLOCK_SIZE || size > 262144 || size % BLOCK_SIZE || block_offset < 0 || block_offset % BLOCK_SIZE ||
+		    block_offset > size - BLOCK_SIZE) {
+			Fail(ErrorCode::Storage, "Invalid block payload slice");
+		}
+		Check(db, sqlite3_blob_read(blob, target, amount, int(block_offset) + source_offset));
+	}
+
+private:
+	sqlite3 *db;
+	sqlite3_blob *blob = nullptr;
+	int64_t current = 0;
+};
+
+std::string Payload(sqlite3 *db, int64_t id, int64_t offset) {
+	std::string data(BLOCK_SIZE, '\0');
+	PayloadReader reader(db);
+	reader.Read(id, offset, 0, BLOCK_SIZE, &data[0]);
+	return data;
