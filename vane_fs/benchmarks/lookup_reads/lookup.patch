+static void CheckLookupReads(const std::string &path, Durability durability) {
+	Workspace workspace(path, 20, durability);
+	auto main = workspace.Checkout();
+	main->WriteFile("/file", "retained bytes");
+	main->WriteFile("/first", "first reference");
+	main->MakeDirectory("/dir");
+	auto snapshot_id = workspace.Snapshot();
+	auto snapshot = workspace.OpenSnapshot(snapshot_id);
+	workspace.AcquireMount("main");
+	auto root = main->OpenDirectory("/");
+	auto file = main->LookupInode(root.inode, "file");
+	auto directory = main->LookupInode(root.inode, "dir");
+	Inspector inspect(path);
+	auto version = inspect.Integer("PRAGMA data_version");
+	auto pins = inspect.Integer("SELECT count(*) FROM open_inodes");
+	inspect.Exec("BEGIN IMMEDIATE");
+	Expect(ErrorCode::NotFound, [&] { main->LookupInode(root.inode, "missing"); });
+	Require(main->LookupInode(root.inode, "file").inode == file.inode, "Repeated lookup changed identity");
+	Require(main->LookupInode(directory.inode, ".").inode == directory.inode, "Dot changed identity");
+	Require(main->LookupInode(directory.inode, "..").inode == root.inode, "Dot-dot changed identity");
+	Expect(ErrorCode::Invalid, [&] { main->LookupInode(root.inode, "bad/name"); });
+	Expect(ErrorCode::NotDirectory, [&] { main->LookupInode(file.inode, "child"); });
+	Expect(ErrorCode::Closed, [&] { main->LookupInode(987654321, "child"); });
+	Require(snapshot->LookupInode(1, "first").inode == main->Stat("/first").inode, "Snapshot lookup changed");
+	Expect(ErrorCode::NotFound, [&] { snapshot->LookupInode(1, "missing"); });
+	// The first pin must still obtain the writer lock, and a failed pin must
+	// not retain a temporary reference or publish a durable one.
+	Expect(ErrorCode::Busy, [&] { main->LookupInode(root.inode, "first"); });
+	Require(inspect.Integer("SELECT count(*) FROM open_inodes") == pins, "Failed first lookup leaked a pin");
+	inspect.Exec("ROLLBACK");
+	Require(inspect.Integer("PRAGMA data_version") == version, "Read lookups modified the main database");
+	auto first = main->LookupInode(root.inode, "first");
+	main->CloseFile(first.inode);
+	Expect(ErrorCode::Closed, [&] { main->StatInode(first.inode); });
+
+	main->Rename("/dir", "/moved");
+	main->MakeDirectory("/dir");
+	main->WriteFile("/dir/new", "different parent");
+	Expect(ErrorCode::NotFound, [&] { main->LookupInode(directory.inode, "new"); });
+	main->RemoveDirectory("/moved");
+	Expect(ErrorCode::NotFound, [&] { main->LookupInode(directory.inode, "child"); });
+	main->CloseFile(directory.inode, 2);
+	main->Unlink("/file");
+	workspace.CollectGarbage();
+	main->CloseFile(file.inode);
+	Require(main->ReadInode(file.inode, 0, 100) == "retained bytes", "Read-only lookup lost its reference");
+	main->CloseFile(file.inode);
+	Expect(ErrorCode::Closed, [&] { main->StatInode(file.inode); });
+	main->CloseFile(root.inode, 2);
+	workspace.ReleaseMount("main");
+	snapshot->Close();
+	workspace.DropSnapshot(snapshot_id);
+	main->Close();
+	Expect(ErrorCode::Closed, [&] { main->LookupInode(1, "file"); });
+}
