+// SPDX-FileCopyrightText: 2026 Vane contributors
+// SPDX-License-Identifier: Apache-2.0
+
+#include "vane_fs/workspace.hpp"
+#include <sqlite3.h>
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <iostream>
+
+using namespace vane_fs;
+
+namespace {
+thread_local bool armed = false, injected = false;
+thread_local sqlite3 *other = nullptr;
+thread_local std::string mutation;
+
+void Require(bool ok, const char *message) {
+	if (!ok)
+		throw std::runtime_error(message);
+}
+} // namespace
+
+extern "C" int __real_sqlite3_exec(sqlite3 *, const char *, int (*)(void *, int, char **, char **), void *, char **);
+extern "C" int __real_sqlite3_step(sqlite3_stmt *);
+
+static void AfterCommit(sqlite3 *db) {
+	if (!armed)
+		return;
+	armed = false;
+	// Precisely interleave after the read transaction releases its SQLite lock,
+	// before the subsequent BEGIN IMMEDIATE. Direct SQL also lets us exercise
+	// other-connection invalidation despite the public API's mount exclusion.
+	Require(sqlite3_get_autocommit(db), "Injection did not run between transactions");
+	auto target = other ? other : db;
+	Require(__real_sqlite3_exec(target, mutation.c_str(), nullptr, nullptr, nullptr) == SQLITE_OK,
+	        "Interleaved mutation failed");
+	injected = true;
+}
+
+extern "C" int __wrap_sqlite3_exec(sqlite3 *db, const char *sql, int (*callback)(void *, int, char **, char **),
+                                   void *context, char **error) {
+	auto code = __real_sqlite3_exec(db, sql, callback, context, error);
+	if (code == SQLITE_OK && std::strcmp(sql, "COMMIT") == 0)
+		AfterCommit(db);
+	return code;
+}
+
+extern "C" int __wrap_sqlite3_step(sqlite3_stmt *statement) {
+	auto code = __real_sqlite3_step(statement);
+	if (code == SQLITE_DONE && std::strcmp(sqlite3_sql(statement), "COMMIT") == 0)
+		AfterCommit(sqlite3_db_handle(statement));
+	return code;
+}
+
+static void Check(const std::string &path, bool external, const std::string &operation) {
+	Workspace workspace(path);
+	auto session = workspace.Checkout();
+	session->WriteFile("/file", "original");
+	session->WriteFile("/replacement", "replacement");
+	auto replacement = session->Stat("/replacement").inode;
+	workspace.AcquireMount("main");
+	auto root = session->OpenDirectory("/");
+	sqlite3 *inspection = nullptr;
+	Require(sqlite3_open(path.c_str(), &inspection) == SQLITE_OK, "Opening second connection");
+	other = external ? inspection : nullptr;
+	if (operation == "unlink")
+		mutation = "DELETE FROM dirent_versions WHERE name='file'";
+	else if (operation == "replace")
+		mutation = "UPDATE dirent_versions SET inode=" + std::to_string(replacement) + " WHERE name='file'";
+	else if (operation == "parent")
+		mutation = "DELETE FROM open_inodes WHERE inode=1";
+	else
+		mutation = "CREATE TRIGGER fail_lookup_pin BEFORE INSERT ON open_inodes "
+		           "BEGIN SELECT RAISE(ABORT,'injected pin failure'); END";
+	injected = false;
+	armed = true;
+	bool expected_error = false;
+	try {
+		auto file = session->LookupInode(root.inode, "file");
+		Require(operation == "replace" && file.inode == replacement, "Lookup reused stale namespace data");
+		Require(session->ReadInode(file.inode, 0, 100) == "replacement", "Replacement was not pinned");
+		session->CloseFile(file.inode);
+	} catch (const Error &error) {
+		expected_error = (operation == "unlink" && error.code == ErrorCode::NotFound) ||
+		                 (operation == "parent" && error.code == ErrorCode::Closed) ||
+		                 (operation == "pin_failure" && error.code == ErrorCode::Storage);
+		Require(expected_error, "Unexpected validation error");
+	}
+	armed = false;
+	other = nullptr;
+	sqlite3_close(inspection);
+	Require(injected, "Lookup did not reach the interleaving point");
+	Require(operation == "replace" || expected_error, "Lookup ignored an interleaved mutation");
+	if (operation == "pin_failure") {
+		// Removing the injected failure must allow exactly one successful pin.
+		sqlite3 *remove = nullptr;
+		Require(sqlite3_open(path.c_str(), &remove) == SQLITE_OK, "Opening trigger cleanup connection");
+		Require(sqlite3_exec(remove, "DROP TRIGGER fail_lookup_pin", nullptr, nullptr, nullptr) == SQLITE_OK,
+		        "Removing trigger");
+		sqlite3_close(remove);
+		auto file = session->LookupInode(root.inode, "file");
+		session->CloseFile(file.inode);
+		bool closed = false;
+		try {
+			session->StatInode(file.inode);
+		} catch (const Error &error) {
+			closed = error.code == ErrorCode::Closed;
+		}
+		Require(closed, "Failed pin retained a reference");
+	}
+	workspace.ReleaseMount("main");
+}
+
+int main() {
+	auto root =
+	    std::filesystem::temp_directory_path() /
+	    ("vane-fs-lookup-validation-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+	try {
+		std::filesystem::create_directory(root);
+		for (bool external : {false, true}) {
+			for (const auto *operation : {"unlink", "replace", "parent", "pin_failure"}) {
+				auto name = std::to_string(external) + "-" + operation + ".sqlite";
+				Check((root / name).string(), external, operation);
+			}
+		}
+		std::filesystem::remove_all(root);
+		std::cout << "First lookup revalidates same/other-connection changes and rolls back failed pins\n";
+		return 0;
+	} catch (const std::exception &error) {
+		armed = false;
+		std::cerr << error.what() << '\n';
+		std::filesystem::remove_all(root);
+		return 1;
+	}
+}
