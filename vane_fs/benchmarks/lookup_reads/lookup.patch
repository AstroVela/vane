+static void CheckConcurrentLookups(const std::string &path) {
+	Workspace workspace(path, 1000, Durability::Fsync);
+	workspace.AcquireMount("main");
+	auto writer = workspace.Checkout();
+	auto reader = workspace.Checkout();
+	auto root = reader->OpenDirectory("/");
+	writer->WriteFile("/entry", "pinned content");
+	std::atomic<bool> started {false};
+	std::exception_ptr failure;
+	std::thread changes([&] {
+		try {
+			while (!started.load())
+				std::this_thread::yield();
+			for (int i = 0; i < 200; ++i) {
+				writer->Rename("/entry", "/moved");
+				writer->WriteFile("/entry", "pinned content");
+				writer->Unlink("/moved");
+				workspace.CollectGarbage();
+			}
+		} catch (...) {
+			failure = std::current_exception();
+		}
+	});
+	std::exception_ptr read_failure;
+	try {
+		started.store(true);
+		for (int i = 0; i < 400; ++i) {
+			FileStat file;
+			try {
+				file = reader->LookupInode(root.inode, "entry");
+			} catch (const Error &error) {
+				if (error.code == ErrorCode::NotFound)
+					continue;
+				throw;
+			}
+			Require(reader->ReadInode(file.inode, 0, 100) == "pinned content", "Lookup returned an unpinned inode");
+			reader->CloseFile(file.inode);
+		}
+	} catch (...) {
+		read_failure = std::current_exception();
+	}
+	changes.join();
+	if (failure)
+		std::rethrow_exception(failure);
+	if (read_failure)
+		std::rethrow_exception(read_failure);
+	reader->CloseFile(root.inode);
+	workspace.ReleaseMount("main");
+	Inspector inspect(path);
+	Require(inspect.Integer("SELECT count(*) FROM open_inodes") == 0, "Concurrent lookup leaked references");
+	Require(inspect.Integer("SELECT count(*) FROM orphans") == 0, "Concurrent lookup leaked orphan data");
+}
