+extern "C" int __real_fdatasync(int);
+extern "C" int __wrap_fdatasync(int fd) {
+	auto rc = __real_fdatasync(fd);
+	if (!rc && !synced_images.empty()) {
+		char target[4096];
+		auto name = "/proc/self/fd/" + std::to_string(fd);
+		auto n = readlink(name.c_str(), target, sizeof(target));
+		if (n <= 0)
+			return -1;
+		auto path = std::filesystem::path(std::string(target, size_t(n)));
+		std::error_code error;
+		std::filesystem::copy_file(path, synced_images / path.filename(),
+		                           std::filesystem::copy_options::overwrite_existing, error);
+		if (error)
+			return -1;
+	}
+	return rc;
+}
