+@pytest.mark.parametrize("offset", [1, 4095])
+@pytest.mark.parametrize("edges", ["head", "tail", "both"])
+def test_large_write_preserves_partial_edges_and_views(workspace, database_path, offset, edges):
+    block = 4096
+    data = b"".join(bytes([i if i % 5 else 0]) * block for i in range(193)) + b"tail"
+    tail = (offset + len(data)) // block * block
+    main = workspace.checkout()
+    main.write_file("/file", b"p" * block if edges != "tail" else b"")
+    if edges != "head":
+        main.write("/file", b"s" * block, tail)
+    original = main.read("/file")
+    saved = workspace.snapshot()
+    child = workspace.checkout(workspace.fork("main", "child").id)
+    expected = bytearray(original)
+    expected[offset : offset + len(data)] = data
+    child.write("/file", data, offset)
+    with workspace.open_snapshot(saved) as frozen:
+        assert child.read("/file") == bytes(expected)
+        assert main.read("/file") == original
+        assert frozen.read("/file") == original
+        workspace.collect_garbage()
+        assert child.read("/file") == bytes(expected)
+        assert frozen.read("/file") == original
+    with Workspace(database_path) as reopened:
+        assert reopened.checkout(child.id).read("/file") == bytes(expected)
