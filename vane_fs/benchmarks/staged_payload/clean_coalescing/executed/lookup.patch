+Record LookupChild(sqlite3 *db, int64_t parent, const std::string &name, const View &view) {
+	if (name == "." || name == "..") {
+		auto directory = OpenedInode(db, parent, view);
+		if (!directory.fields[0])
+			Fail(ErrorCode::NotDirectory, "Parent is not a directory");
+		return Inode(db, name == "." ? parent : ParentInode(db, parent, view), view);
+	}
+	auto key = ChildKey(db, parent, name, view);
+	Record entry;
+	if (!Get(db, DIRENTS, key, view.point, entry))
+		Fail(ErrorCode::NotFound, "Entry does not exist");
+	return Inode(db, entry.fields[0], view);
+}
+
+unsigned DataVersion(sqlite3 *db) {
+	unsigned version = 0;
+	Check(db, sqlite3_file_control(db, "main", SQLITE_FCNTL_DATA_VERSION, &version));
+	return version;
+}
