+	auto syncs = foreground_wal_syncs.load();
+	session->WriteFile("/file", std::string(32 * MIB, 'd'));
+	Require(foreground_database_writes == writes, "Checkpoint copied database pages on the mutation thread");
+	if (durability == Durability::Strict)
+		Require(foreground_wal_syncs > syncs, "Strict write did not synchronize before acknowledgement");
+	Wait([] { return paused.load(); });
+	syncs = foreground_wal_syncs.load();
+	session->Write("/file", "ok", 0);
