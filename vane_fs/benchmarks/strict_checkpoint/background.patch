+	});
+	Require(!fail_foreground_sync, "Foreground WAL sync fault was not reached");
+	Require(session->Read("/file", 0, 2) == "ok", "Failed foreground barrier changed acknowledged bytes");
+	syncs = foreground_wal_syncs.load();
+	workspace.Sync();
+	Require(foreground_wal_syncs > syncs, "Retry missed the foreground WAL barrier");
+	pause_background = false;
