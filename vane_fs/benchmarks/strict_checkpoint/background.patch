+	        "Paused checkpoint changed ordinary write durability");
+	// A stuck checkpoint must neither perform nor absorb foreground barriers.
+	fail_foreground_sync = true;
+	Expect(ErrorCode::Storage, [&] {
+		if (durability == Durability::Strict)
