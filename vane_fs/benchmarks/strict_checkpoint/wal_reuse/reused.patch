+static void CheckAllocationReuse(const std::string &path, int page_size, Durability durability) {
+	{
+		Inspector inspector(path);
+		inspector.SQL(page_size == 8192 ? "PRAGMA page_size=8192; VACUUM" : "PRAGMA page_size=4096; VACUUM");
+	}
+	{
+		Workspace workspace(path, 1000, durability);
+		auto session = workspace.Checkout();
+		session->WriteFile("/file", "small");
+		Require(std::filesystem::file_size(path + "-wal") < MIB, "Small workspace unexpectedly preallocated WAL");
+		// An atomic write can exceed the admission budget. Its successor
+		// must reset the generation and reclaim only the excess allocation.
+		session->WriteFile("/file", std::string(64 * MIB, 'a'));
+		Require(std::filesystem::file_size(path + "-wal") > 64 * MIB, "Missing oversized WAL allocation");
+		session->Write("/file", "ok", 0);
+		Require(std::filesystem::file_size(path + "-wal") == 64 * MIB,
+		        "Oversized WAL did not shrink to reuse capacity");
+		for (int i = 1; i <= 24; ++i) {
+			auto syncs = foreground_wal_syncs.load();
+			session->Write("/file", std::string(MIB, 'r'), int64_t(i) * MIB);
+			if (durability == Durability::Strict)
+				Require(foreground_wal_syncs > syncs, "Reused allocation skipped the strict commit barrier");
+			Require(std::filesystem::file_size(path + "-wal") == 64 * MIB, "WAL shrank or grew during capacity reuse");
+		}
+		workspace.Close();
+	}
+	Require(!std::filesystem::exists(path + "-wal"), "Final close retained WAL allocation");
+	Require(!std::filesystem::exists(path + "-shm"), "Final close retained shared memory");
+	{
+		Workspace workspace(path, 1000, durability);
+		auto session = workspace.Checkout();
+		Require(session->Read("/file", 0, 2) == "ok", "Reopen lost the first reused write");
+		Require(session->Read("/file", MIB, 24 * MIB) == std::string(24 * MIB, 'r'), "Reopen changed reused bytes");
+		Require(session->Read("/file", 63 * MIB) == std::string(MIB, 'a'), "Reopen changed untouched bytes");
+		Require(std::filesystem::file_size(path + "-wal") < MIB, "Reopen unexpectedly preallocated WAL");
+		workspace.Close();
+	}
+	Require(!std::filesystem::exists(path + "-wal"), "Reopened workspace did not reclaim WAL");
 }
 
