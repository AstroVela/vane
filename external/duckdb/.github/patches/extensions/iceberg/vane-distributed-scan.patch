+unique_ptr<MultiFileList> IcebergMultiFileList::Copy() const {
+	auto result = make_uniq<IcebergMultiFileList>(context, scan_info, path, options_owner);
+	result->table = table;
+	result->have_bound = have_bound;
+	result->names = names;
+	result->types = types;
+	for (auto &entry : table_filters.filters) {
+		result->table_filters.PushFilter(ColumnIndex(entry.first), entry.second->Copy());
+	}
+	result->distributed_task_filter_enabled = distributed_task_filter_enabled;
+	result->distributed_task_paths = distributed_task_paths;
+	return std::move(result);
+}
+
+vector<OpenFileInfo> IcebergMultiFileList::GetScanTasks() const {
+	return GetAllFiles();
+}
+
+optional_idx IcebergMultiFileList::GetScanTaskEstimatedBytes(const OpenFileInfo &task) const {
+	if (!task.extended_info) {
+		return optional_idx();
+	}
+	auto entry = task.extended_info->options.find("file_size");
+	if (entry == task.extended_info->options.end() || entry->second.IsNull()) {
+		return optional_idx();
+	}
+	return optional_idx(entry->second.GetValue<uint64_t>());
+}
+
+void IcebergMultiFileList::SetScanTasks(const vector<OpenFileInfo> &tasks) {
+	lock_guard<mutex> guard(lock);
+	distributed_task_filter_enabled = true;
+	distributed_task_paths.clear();
+	for (auto &task : tasks) {
+		distributed_task_paths.insert(task.path);
+	}
+	manifest_entries.erase(std::remove_if(manifest_entries.begin(), manifest_entries.end(),
+	                                      [&](const IcebergManifestEntry &entry) {
+		                                      return distributed_task_paths.find(ResolveDataFilePath(
+		                                                 entry.data_file.file_path)) == distributed_task_paths.end();
+	                                      }),
+	                       manifest_entries.end());
+}
+
+void IcebergMultiFileList::PrepareWorkerBind(vector<Value> &parameters, named_parameter_map_t &named_parameters) const {
+	if (!scan_info || scan_info->metadata_path.empty()) {
+		throw InvalidConfigurationException(
+		    "Distributed Iceberg planning did not resolve an immutable metadata JSON path");
+	}
+	if (HasTransactionData()) {
+		throw NotImplementedException("Distributed Iceberg scans do not support uncommitted transaction data");
+	}
+	parameters.clear();
+	parameters.emplace_back(path);
+	named_parameters["_vane_distributed_worker"] = Value::BOOLEAN(true);
+	// Rebind the exact metadata JSON selected during planning. Resolving a
+	// version hint again on a worker can select a newer, uncommitted table
+	// state and is unnecessary metadata I/O for every task attempt.
+	named_parameters["_vane_metadata_path"] = Value(scan_info->metadata_path);
+	auto snapshot = GetSnapshot();
+	if (!snapshot) {
+		return;
+	}
+	named_parameters.erase("snapshot_from_timestamp");
+	named_parameters.erase("snapshot_from_id");
+	named_parameters["snapshot_from_id"] = Value::UBIGINT(static_cast<uint64_t>(snapshot->snapshot_id));
+}
