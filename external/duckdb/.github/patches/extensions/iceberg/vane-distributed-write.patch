+
+void IcebergInsert::ValidateExtensionWrite(ClientContext &context) const {
+	(void)context;
+	if (!table || create_table_as) {
+		throw NotImplementedException("Distributed Iceberg writes only support INSERT INTO an existing table");
+	}
+	auto &iceberg_table = table->Cast<IcebergTableEntry>();
+	auto &metadata = iceberg_table.table_info.table_metadata;
+	if (metadata.iceberg_version != 2) {
+		throw NotImplementedException("Distributed Iceberg writes require an Iceberg v2 table");
+	}
+	if (!metadata.GetLatestPartitionSpec().IsUnpartitioned()) {
+		throw NotImplementedException("Distributed Iceberg writes do not support partitioned tables");
+	}
+	if (metadata.HasSortOrder() && metadata.GetLatestSortOrder().IsSorted()) {
+		throw NotImplementedException("Distributed Iceberg writes do not support sorted tables");
+	}
+}
+
+idx_t IcebergInsert::FinalizeExtensionWrite(
+    ClientContext &context, const vector<distributed::DistributedCopyFileInfo> &files) const {
+	IcebergInsertGlobalState global_state(context);
+	auto return_types = GetCopyFunctionReturnLogicalTypes(CopyFunctionReturnType::WRITTEN_FILE_STATISTICS);
+	DataChunk chunk;
+	chunk.Initialize(Allocator::Get(context), return_types);
+
+	for (idx_t offset = 0; offset < files.size(); offset += STANDARD_VECTOR_SIZE) {
+		auto count = MinValue<idx_t>(STANDARD_VECTOR_SIZE, files.size() - offset);
+		chunk.Reset();
+		chunk.SetCardinality(count);
+		for (idx_t row = 0; row < count; row++) {
+			auto &file = files[offset + row];
+			if (file.final_path.empty()) {
+				throw InvalidInputException("Distributed Iceberg write received a file without a final path");
+			}
+			chunk.SetValue(0, row, Value(file.final_path));
+			chunk.SetValue(1, row, Value::UBIGINT(file.row_count));
+			chunk.SetValue(2, row, Value::UBIGINT(file.file_size_bytes));
+			chunk.SetValue(3, row, file.footer_size_bytes);
+			chunk.SetValue(4, row, file.column_statistics);
+			chunk.SetValue(5, row, file.partition_keys);
+		}
+		AddWrittenFiles(global_state, chunk, table);
+	}
+
+	FinalizeWrittenFiles(global_state, context, table);
+	auto &transaction = IcebergTransaction::Get(context, table->catalog);
+	transaction.RetainFilesOnCommitFailure();
+	return global_state.insert_count.load();
 }
 
