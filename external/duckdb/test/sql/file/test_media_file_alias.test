# name: test/sql/file/test_media_file_alias.test
# description: Test media-specialized FILE aliases, pure conversion, and family functions
# group: [file]

require file

load __TEST_DIR__/media_file.db

statement ok
PRAGMA enable_verification

query TTTTTT
SELECT
	typeof(image_file('missing.png')),
	typeof(audio_file('missing.mp3')),
	typeof(video_file('missing.mp4')),
	typeof(NULL::IMAGEFILE[]),
	typeof(NULL::AUDIOFILE[]),
	typeof(NULL::VIDEOFILE[])
----
IMAGEFILE	AUDIOFILE	VIDEOFILE	IMAGEFILE[]	AUDIOFILE[]	VIDEOFILE[]

# Unverified construction and specialization are pure and preserve all fields.
query TTTIIT
SELECT typeof(value), value.url, value.content_type, value.position, value.size, value.checksum
FROM (
	SELECT image_file(file('memory://image', 'image/png', 2, 4, 'sha256:image')) AS value
)
----
IMAGEFILE	memory://image	image/png	2	4	sha256:image

query TTT
SELECT
	typeof(image_file(image_file('memory://image'))),
	typeof(audio_file(file('memory://audio', NULL, NULL, NULL, NULL))),
	typeof(video_file(file('memory://video', NULL, NULL, NULL, NULL)))
----
IMAGEFILE	AUDIOFILE	VIDEOFILE

statement error
SELECT image_file(audio_file('memory://audio'))
----
<REGEX>:.*image_file.*requires VARCHAR, FILE, or IMAGEFILE.*AUDIOFILE.*

statement error
SELECT audio_file(video_file('memory://video'))
----
<REGEX>:.*audio_file.*requires VARCHAR, FILE, or AUDIOFILE.*VIDEOFILE.*

# The optional verification path uses bounded content inspection.
query TT
SELECT
	typeof(image_file('logo/DuckDB_Logo-stacked.png', TRUE)),
	image_file('logo/DuckDB_Logo-stacked.png', TRUE).content_type
----
IMAGEFILE	image/png

statement error
SELECT image_file('test/sql/table_function/files/one.txt', TRUE)
----
<REGEX>:.*could not verify IMAGEFILE content.*

statement error
SELECT video_file('test/sql/table_function/files/does-not-exist', TRUE)
----
<REGEX>:.*(Cannot open file|could not open).*

query IIIII
SELECT
	image = image,
	image != image,
	partial = partial,
	partial != partial,
	NULL::IMAGEFILE = image
FROM (
	SELECT
		image_file(file('x', 'image/png', 1, 2, 'sha256:x')) AS image,
		image_file(file('x', NULL, NULL, NULL, NULL)) AS partial
)
----
true	false	NULL	NULL	NULL

statement error
SELECT image_file('x') = file('x', NULL, NULL, NULL, NULL)
----
<REGEX>:.*Cannot compare values of type IMAGEFILE and type FILE.*

statement error
SELECT image_file('x') = audio_file('x')
----
<REGEX>:.*Cannot compare values of type IMAGEFILE and type AUDIOFILE.*

# FILE-family aliases are exact logical boundaries. DuckDB's ordinary STRUCT
# casts must not retag a generic FILE, another specialization, or an unaliased
# canonical STRUCT. Common-type and nested cast paths obey the same rule.
statement error
SELECT CAST(image_file('x') AS AUDIOFILE)
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT CAST(file('x', NULL, NULL, NULL, NULL) AS IMAGEFILE)
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT CAST(image_file('x') AS STRUCT(
	url VARCHAR,
	content_type VARCHAR,
	"position" BIGINT,
	size BIGINT,
	checksum VARCHAR
))
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT CAST(image_file('x') AS VARCHAR)
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT {
	'url': 'x',
	'content_type': NULL::VARCHAR,
	'position': NULL::BIGINT,
	'size': NULL::BIGINT,
	'checksum': NULL::VARCHAR
}::IMAGEFILE
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT CASE WHEN TRUE THEN image_file('x') ELSE audio_file('x') END
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT image_file('x') UNION ALL SELECT audio_file('x')
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT [image_file('x')]::AUDIOFILE[]
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement error
SELECT TRY_CAST(video_file('x') AS IMAGEFILE)
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

# Exact casts and NULL common types remain valid.
query TTTT
SELECT
	typeof(CAST(image_file('x') AS IMAGEFILE)),
	typeof(NULL::IMAGEFILE),
	typeof(CASE WHEN TRUE THEN image_file('x') ELSE NULL END),
	typeof(CASE WHEN TRUE THEN NULL ELSE audio_file('x') END)
----
IMAGEFILE	IMAGEFILE	IMAGEFILE	AUDIOFILE

query T
SELECT typeof(value)
FROM (
	SELECT video_file('x') AS value
	UNION ALL
	SELECT NULL
)
LIMIT 1
----
VIDEOFILE

# Internal CSV formatting preserves FILE-family export without admitting a
# user-visible FILE-to-VARCHAR cast, including for nested values.
statement ok
COPY (
	SELECT
		file('generic.csv', NULL, NULL, NULL, NULL) AS generic_file,
		image_file('image.png') AS image_file,
		[audio_file('audio.mp3')] AS audio_files
) TO '__TEST_DIR__/media_files.csv' (FORMAT CSV, HEADER)

query III
SELECT
	contains(generic_file, 'generic.csv'),
	contains(image_file, 'image.png'),
	contains(audio_files, 'audio.mp3')
FROM read_csv('__TEST_DIR__/media_files.csv', header = TRUE, all_varchar = TRUE)
----
true	true	true

# Generic FILE-family functions accept all specializations. Value-returning
# enrichment preserves its input alias, while identity functions compare
# family members explicitly.
query TTTTII
SELECT
	typeof(file_enrich(image_file('image.png'), [])),
	typeof(file_enrich(audio_file('audio.mp3'), [])),
	typeof(file_enrich(video_file('video.mp4'), [])),
	file_path(image_file('image.png')),
	file_same_location(image_file('same'), audio_file('same')),
	file_same_content(
		image_file(file('a', NULL, 0, 3, 'sha256:abc')),
		video_file(file('b', NULL, 7, 3, 'SHA256:abc'))
	)
----
IMAGEFILE	AUDIOFILE	VIDEOFILE	image.png	true	true

statement ok
CREATE TABLE media_files(
	image IMAGEFILE,
	audio AUDIOFILE,
	video VIDEOFILE
)

statement ok
INSERT INTO media_files VALUES (
	image_file('stored.png'),
	audio_file('stored.mp3'),
	video_file('stored.mp4')
)

statement error
INSERT INTO media_files(image) SELECT audio_file('wrong.mp3')
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement ok
PREPARE insert_image AS INSERT INTO media_files(image) VALUES ($1)

statement error
EXECUTE insert_image(audio_file('wrong.mp3'))
----
<REGEX>:.*FILE-family casts require an exact logical type match.*

statement ok
EXECUTE insert_image(image_file('prepared.png'))

query TTTTTT
SELECT
	typeof(image), image.url,
	typeof(audio), audio.url,
	typeof(video), video.url
FROM media_files
ORDER BY image.url DESC
----
IMAGEFILE	stored.png	AUDIOFILE	stored.mp3	VIDEOFILE	stored.mp4
IMAGEFILE	prepared.png	AUDIOFILE	NULL	VIDEOFILE	NULL

restart

query TTTTTT
SELECT
	typeof(image), image.url,
	typeof(audio), audio.url,
	typeof(video), video.url
FROM media_files
ORDER BY image.url DESC
----
IMAGEFILE	stored.png	AUDIOFILE	stored.mp3	VIDEOFILE	stored.mp4
IMAGEFILE	prepared.png	AUDIOFILE	NULL	VIDEOFILE	NULL
