# name: test/sql/file/test_image_type.test
# group: [file]

# SPDX-FileCopyrightText: 2026 Vane contributors
# SPDX-License-Identifier: Apache-2.0

require file

query T
SELECT typeof(NULL::IMAGE)
----
IMAGE

query I
SELECT (NULL::IMAGE).width
----
NULL

query TII
SELECT typeof(value), value.width, value.channels
FROM (SELECT image('\x00'::BLOB, 1, 1, 1, 'L') AS value)
----
IMAGE	1	1

query TI
SELECT typeof(image(NULL::BLOB, 1, 1, 1, 'L')), image(NULL::BLOB, 1, 1, 1, 'L') IS NULL
----
IMAGE	true

statement error
SELECT image('\x00'::BLOB, 1, 1, 3, 'RGB')
----
<REGEX>:.*IMAGE data has 1 bytes, expected 3.*

query IIIIII
SELECT
	value IN (value),
	value NOT IN (other),
	value IS DISTINCT FROM NULL::IMAGE,
	NULL::IMAGE IS NOT DISTINCT FROM NULL::IMAGE,
	value IS DISTINCT FROM value,
	value IS NOT DISTINCT FROM value
FROM (
	SELECT
		image('\x00'::BLOB, 1, 1, 1, 'L') AS value,
		image('\x01'::BLOB, 1, 1, 1, 'L') AS other
)
----
true	true	true	true	false	true

query IIIII
SELECT
	image('\x00'::BLOB, 1, 1, 1, 'L') < image('\x01'::BLOB, 1, 1, 1, 'L'),
	[image('\x00'::BLOB, 1, 1, 1, 'L')] < [image('\x01'::BLOB, 1, 1, 1, 'L')],
	array_value(image('\x00'::BLOB, 1, 1, 1, 'L')) < array_value(image('\x01'::BLOB, 1, 1, 1, 'L')),
	{'value': image('\x00'::BLOB, 1, 1, 1, 'L')} < {'value': image('\x01'::BLOB, 1, 1, 1, 'L')},
	MAP {'value': image('\x00'::BLOB, 1, 1, 1, 'L')} < MAP {'value': image('\x01'::BLOB, 1, 1, 1, 'L')}
----
true	true	true	true	true

query T
SELECT hex(value.data)
FROM (VALUES
	(image('\x01'::BLOB, 1, 1, 1, 'L')),
	(image('\x00'::BLOB, 1, 1, 1, 'L'))
) images(value)
ORDER BY value
----
00
01

query T
SELECT hex((min(value)).data)
FROM (VALUES
	(image('\x01'::BLOB, 1, 1, 1, 'L')),
	(image('\x00'::BLOB, 1, 1, 1, 'L'))
) images(value)
----
00

statement ok
PREPARE compare_image AS
SELECT image('\x00'::BLOB, 1, 1, 1, 'L') = $1

query I
EXECUTE compare_image(image('\x00'::BLOB, 1, 1, 1, 'L'))
----
true

statement error
SELECT struct_pack(
    data := '\x00'::BLOB,
    width := 1::UINTEGER,
    height := 1::UINTEGER,
    channels := 1::UTINYINT,
    mode := 'L'
)::IMAGE
----
<REGEX>:.*governed values require an exact logical type match.*

statement ok
CREATE TABLE decoded_images(value IMAGE)

statement ok
INSERT INTO decoded_images VALUES (NULL)

query TT
SELECT typeof(value), value FROM decoded_images
----
IMAGE	NULL
