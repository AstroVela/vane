require file

query T
SELECT typeof(NULL::IMAGE)
----
IMAGE

query I
SELECT (NULL::IMAGE).width
----
NULL

query TII
SELECT typeof(value), value.width, value.channels
FROM (SELECT image('\x00'::BLOB, 1, 1, 1, 'L') AS value)
----
IMAGE	1	1

query TB
SELECT typeof(image(NULL::BLOB, 1, 1, 1, 'L')), image(NULL::BLOB, 1, 1, 1, 'L') IS NULL
----
IMAGE	true

statement error IMAGE data has 1 bytes, expected 3
SELECT image('\x00'::BLOB, 1, 1, 3, 'RGB')

query BBBBBB
SELECT
	value IN (value),
	value NOT IN (other),
	value IS DISTINCT FROM NULL::IMAGE,
	NULL::IMAGE IS NOT DISTINCT FROM NULL::IMAGE,
	value IS DISTINCT FROM value,
	value IS NOT DISTINCT FROM value
FROM (
	SELECT
		image('\x00'::BLOB, 1, 1, 1, 'L') AS value,
		image('\x01'::BLOB, 1, 1, 1, 'L') AS other
)
----
true	true	true	true	false	true

statement error Cannot compare values of type IMAGE
SELECT image('\x00'::BLOB, 1, 1, 1, 'L') < image('\x01'::BLOB, 1, 1, 1, 'L')

statement error governed values require an exact logical type match
SELECT struct_pack(
    data := '\x00'::BLOB,
    width := 1::UINTEGER,
    height := 1::UINTEGER,
    channels := 1::UTINYINT,
    mode := 'L'
)::IMAGE

statement ok
CREATE TABLE decoded_images(value IMAGE)

statement ok
INSERT INTO decoded_images VALUES (NULL)

query TT
SELECT typeof(value), value FROM decoded_images
----
IMAGE	NULL
