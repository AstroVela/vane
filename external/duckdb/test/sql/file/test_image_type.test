# name: test/sql/file/test_image_type.test
# group: [file]

# SPDX-FileCopyrightText: 2026 Vane contributors
# SPDX-License-Identifier: Apache-2.0

require file

query T
SELECT typeof(NULL::IMAGE)
----
IMAGE

query I
SELECT (NULL::IMAGE).width
----
NULL

query TII
SELECT typeof(value), value.width, value.channel
FROM (SELECT image('\x00'::BLOB, 1, 1, 1, 'L') AS value)
----
IMAGE	1	1

query TI
SELECT typeof(image(NULL::BLOB, 1, 1, 1, 'L')), image(NULL::BLOB, 1, 1, 1, 'L') IS NULL
----
IMAGE	true

statement error
SELECT image('\x00'::BLOB, 1, 1, 3, 'RGB')
----
<REGEX>:.*IMAGE data has 1 pixel values, expected 3.*

query IIIIII
SELECT
	value IN (value),
	value NOT IN (other),
	value IS DISTINCT FROM NULL::IMAGE,
	NULL::IMAGE IS NOT DISTINCT FROM NULL::IMAGE,
	value IS DISTINCT FROM value,
	value IS NOT DISTINCT FROM value
FROM (
	SELECT
		image('\x00'::BLOB, 1, 1, 1, 'L') AS value,
		image('\x01'::BLOB, 1, 1, 1, 'L') AS other
)
----
true	true	true	true	false	true

query IIIII
SELECT
	image('\x00'::BLOB, 1, 1, 1, 'L') < image('\x01'::BLOB, 1, 1, 1, 'L'),
	[image('\x00'::BLOB, 1, 1, 1, 'L')] < [image('\x01'::BLOB, 1, 1, 1, 'L')],
	array_value(image('\x00'::BLOB, 1, 1, 1, 'L')) < array_value(image('\x01'::BLOB, 1, 1, 1, 'L')),
	{'value': image('\x00'::BLOB, 1, 1, 1, 'L')} < {'value': image('\x01'::BLOB, 1, 1, 1, 'L')},
	MAP {'value': image('\x00'::BLOB, 1, 1, 1, 'L')} < MAP {'value': image('\x01'::BLOB, 1, 1, 1, 'L')}
----
true	true	true	true	true

query T
SELECT value.data
FROM (VALUES
	(image('\x01'::BLOB, 1, 1, 1, 'L')),
	(image('\x00'::BLOB, 1, 1, 1, 'L'))
) images(value)
ORDER BY value
----
[0]
[1]

query T
SELECT (min(value)).data
FROM (VALUES
	(image('\x01'::BLOB, 1, 1, 1, 'L')),
	(image('\x00'::BLOB, 1, 1, 1, 'L'))
) images(value)
----
[0]

statement ok
PREPARE compare_image AS
SELECT image('\x00'::BLOB, 1, 1, 1, 'L') = $1

query I
EXECUTE compare_image(image('\x00'::BLOB, 1, 1, 1, 'L'))
----
true

statement error
SELECT struct_pack(
    data := '\x00'::BLOB,
    width := 1::UINTEGER,
    height := 1::UINTEGER,
    channels := 1::UTINYINT,
    mode := 'L'
)::IMAGE
----
<REGEX>:.*governed values require an exact logical type match.*

statement ok
CREATE TABLE decoded_images(value IMAGE)

statement ok
INSERT INTO decoded_images VALUES (NULL)

query TT
SELECT typeof(value), value FROM decoded_images
----
IMAGE	NULL

# Mode-only types retain color constraints across shape changes.
query TTT
SELECT typeof(NULL::IMAGE('RGB')), typeof(NULL::IMAGE('RGB', 1, 2)), typeof(image_width(NULL::IMAGE))
----
IMAGE('RGB')	IMAGE('RGB', 1, 2)	UINTEGER

query IIII
SELECT image_width(value), image_height(value), image_channel(value), image_mode(value)
FROM (SELECT image('abcdef'::BLOB, 2, 1, 3, 'RGB')::IMAGE('RGB', 1, 2) AS value)
----
2	1	3	3

query T
SELECT typeof(value) FROM (
    SELECT image('abc'::BLOB, 1, 1, 3, 'RGB')::IMAGE('RGB', 1, 1) AS value
    UNION ALL
    SELECT image('abcdef'::BLOB, 2, 1, 3, 'RGB')::IMAGE('RGB', 1, 2)
)
----
IMAGE('RGB')
IMAGE('RGB')

query III
SELECT image_attribute(value, 'width'), image_attribute(value, 'mode'), TRY_CAST(value AS IMAGE('L')) IS NULL
FROM (SELECT image('abc'::BLOB, 1, 1, 3, 'RGB') AS value)
----
1	3	true

statement error
SELECT image('abc'::BLOB, 1, 1, 3, 'RGB')::IMAGE('L')
----
<REGEX>:.*does not match.*

statement error
SELECT image_width('not pixels')
----
<REGEX>:.*requires IMAGE.*

statement ok
PREPARE image_attributes AS SELECT image_width($1), image_mode($1)

query II
EXECUTE image_attributes(image('abc'::BLOB, 1, 1, 3, 'RGB'))
----
1	3

# Fixed IMAGE and nested IMAGE arrays retain layout while sorting NULL rows.
statement ok
CREATE TABLE ordered_images AS
SELECT i, CASE WHEN i = 1 THEN NULL ELSE CAST(image('abc'::BLOB, 1, 1, 3, 'RGB') AS IMAGE('RGB', 1, 1)) END AS image
FROM range(3) t(i)

query III
SELECT i, image_width(image), image_mode(image) FROM (SELECT * FROM ordered_images ORDER BY i DESC)
----
2	1	3
1	NULL	NULL
0	1	3

query III
SELECT i, image_width(images[1]), image_mode(images[1])
FROM (SELECT i, [image] AS images FROM ordered_images ORDER BY i DESC)
----
2	1	3
1	NULL	NULL
0	1	3

query T
SELECT image FROM ordered_images ORDER BY i DESC
----
Image(mode=RGB, height=1, width=1)
NULL
Image(mode=RGB, height=1, width=1)

query T
SELECT [image] FROM ordered_images ORDER BY i DESC
----
[Image(mode=RGB, height=1, width=1)]
[NULL]
[Image(mode=RGB, height=1, width=1)]
