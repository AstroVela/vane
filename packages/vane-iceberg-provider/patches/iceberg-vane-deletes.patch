+hash_t VaneIcebergEqualityHash(const vector<Value> &values) {
+	hash_t result = 0;
+	for (auto &value : values) {
+		result = CombineHash(MurmurHash64(result), value.Hash());
+	}
+	return result;
+}
+
+void VaneValidateIcebergPath(const string &path) {
+	const bool absolute = StringUtil::StartsWith(path, "/") || StringUtil::StartsWith(path, "\\\\") ||
+	                      (path.size() >= 3 && path[1] == ':' && (path[2] == '/' || path[2] == '\\'));
+	if (path.empty() || path.find('\0') != string::npos || (!StringUtil::StartsWith(path, "file:///") && !absolute)) {
+		throw NotImplementedException("Frozen Iceberg transport requires absolute local file paths");
+	}
+	if (path.find("://") != string::npos && !StringUtil::StartsWith(path, "file:///")) {
+		throw NotImplementedException("Frozen Iceberg transport currently supports local files only");
+	}
+}
+
+void VaneIcebergPartition::Serialize(Serializer &serializer) const {
+	serializer.WriteProperty(1, "spec_id", spec_id);
+	serializer.WriteProperty(2, "unpartitioned", unpartitioned);
+	serializer.WriteProperty(3, "field_ids", field_ids);
+	serializer.WriteProperty(4, "values", values);
+}
+
+VaneIcebergPartition VaneIcebergPartition::Deserialize(Deserializer &deserializer) {
+	VaneIcebergPartition result;
+	result.spec_id = deserializer.ReadProperty<int32_t>(1, "spec_id");
+	result.unpartitioned = deserializer.ReadProperty<bool>(2, "unpartitioned");
+	result.field_ids = deserializer.ReadProperty<vector<int32_t>>(3, "field_ids");
+	result.values = deserializer.ReadProperty<vector<Value>>(4, "values");
+	result.Validate();
+	return result;
+}
+
+void VaneIcebergPartition::Validate() const {
+	if (spec_id < 0 || field_ids.size() != values.size()) {
+		throw SerializationException("Invalid frozen Iceberg delete partition");
+	}
+	set<int32_t> seen;
+	for (idx_t index = 0; index < field_ids.size(); index++) {
+		if (field_ids[index] <= 0 || !seen.insert(field_ids[index]).second || values[index].type().IsNested() ||
+		    (unpartitioned && !values[index].IsNull())) {
+			throw SerializationException("Invalid frozen Iceberg delete partition field");
+		}
+	}
+	if (!unpartitioned && field_ids.empty()) {
+		throw SerializationException("Partitioned frozen Iceberg state requires partition fields");
+	}
+}
+
+bool VaneIcebergPartition::Equals(const VaneIcebergPartition &other) const {
+	if (spec_id != other.spec_id || unpartitioned != other.unpartitioned || field_ids != other.field_ids ||
+	    values.size() != other.values.size()) {
+		return false;
+	}
+	for (idx_t index = 0; index < values.size(); index++) {
+		if (values[index].type() != other.values[index].type() ||
+		    !Value::NotDistinctFrom(values[index], other.values[index])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void VaneIcebergDeleteColumn::Serialize(Serializer &serializer) const {
+	serializer.WriteProperty(1, "field_id", field_id);
+	serializer.WriteProperty(2, "type", type);
+}
+
+VaneIcebergDeleteColumn VaneIcebergDeleteColumn::Deserialize(Deserializer &deserializer) {
+	VaneIcebergDeleteColumn result;
+	result.field_id = deserializer.ReadProperty<int32_t>(1, "field_id");
+	result.type = deserializer.ReadProperty<LogicalType>(2, "type");
+	result.Validate();
+	return result;
+}
+
+void VaneIcebergDeleteColumn::Validate() const {
+	if (field_id <= 0) {
+		throw SerializationException("Frozen Iceberg equality delete requires positive field IDs");
+	}
+	switch (type.id()) {
+	case LogicalTypeId::BOOLEAN:
+	case LogicalTypeId::INTEGER:
+	case LogicalTypeId::BIGINT:
+	case LogicalTypeId::DECIMAL:
+	case LogicalTypeId::VARCHAR:
+	case LogicalTypeId::BLOB:
+	case LogicalTypeId::UUID:
+	case LogicalTypeId::DATE:
+	case LogicalTypeId::TIME:
+	case LogicalTypeId::TIMESTAMP:
+	case LogicalTypeId::TIMESTAMP_TZ:
+		return;
+	default:
+		throw NotImplementedException("Frozen Iceberg equality delete does not support field type %s", type);
+	}
+}
+
+void VaneIcebergDeleteFile::Serialize(Serializer &serializer) const {
+	serializer.WriteProperty(1, "path", path);
+	serializer.WriteProperty(2, "content", content);
+	serializer.WriteProperty(3, "sequence_number", sequence_number);
+	serializer.WriteProperty(4, "record_count", record_count);
+	serializer.WriteProperty(5, "file_size", file_size);
+	serializer.WriteProperty(6, "partition", partition);
+	serializer.WriteProperty(7, "referenced_data_file", referenced_data_file);
+	serializer.WriteProperty(8, "equality_ids", equality_ids);
+}
+
+VaneIcebergDeleteFile VaneIcebergDeleteFile::Deserialize(Deserializer &deserializer) {
+	VaneIcebergDeleteFile result;
+	result.path = deserializer.ReadProperty<string>(1, "path");
+	result.content = deserializer.ReadProperty<uint8_t>(2, "content");
+	result.sequence_number = deserializer.ReadProperty<int64_t>(3, "sequence_number");
+	result.record_count = deserializer.ReadProperty<int64_t>(4, "record_count");
+	result.file_size = deserializer.ReadProperty<int64_t>(5, "file_size");
+	result.partition = deserializer.ReadProperty<VaneIcebergPartition>(6, "partition");
+	result.referenced_data_file = deserializer.ReadProperty<string>(7, "referenced_data_file");
+	result.equality_ids = deserializer.ReadProperty<vector<int32_t>>(8, "equality_ids");
+	return result;
+}
+
+void VaneIcebergDeleteFile::Validate(const vector<VaneIcebergDeleteColumn> &columns) const {
+	VaneValidateIcebergPath(path);
+	partition.Validate();
+	if (sequence_number < 0 || record_count < 0 || file_size <= 0 || (content != 1 && content != 2)) {
+		throw SerializationException("Invalid frozen Iceberg delete file");
+	}
+	if (!referenced_data_file.empty()) {
+		VaneValidateIcebergPath(referenced_data_file);
+	}
+	if ((content == 1 && !equality_ids.empty()) ||
+	    (content == 2 && (equality_ids.empty() || !referenced_data_file.empty()))) {
+		throw SerializationException("Invalid frozen Iceberg delete file fields");
+	}
+	set<int32_t> seen;
+	for (auto id : equality_ids) {
+		bool found = false;
+		for (auto &column : columns) {
+			found = found || column.field_id == id;
+		}
+		if (!found || !seen.insert(id).second) {
+			throw SerializationException("Frozen Iceberg equality delete references an unknown or duplicate field");
+		}
+	}
+}
+
+bool VaneIcebergDeleteFile::Equals(const VaneIcebergDeleteFile &other) const {
+	return path == other.path && content == other.content && sequence_number == other.sequence_number &&
+	       record_count == other.record_count && file_size == other.file_size && partition.Equals(other.partition) &&
+	       referenced_data_file == other.referenced_data_file && equality_ids == other.equality_ids;
+}
+
+bool VaneIcebergDeleteFile::AppliesTo(const string &data_path, int64_t data_sequence,
+                                      const VaneIcebergPartition &data_partition) const {
+	if (content == 1) {
+		return data_sequence <= sequence_number && partition.Equals(data_partition) &&
+		       (referenced_data_file.empty() || referenced_data_file == data_path);
+	}
+	return content == 2 && data_sequence < sequence_number &&
+	       (partition.unpartitioned || partition.Equals(data_partition));
+}
+
+VaneIcebergPartition VaneFreezeIcebergPartition(const IcebergTableMetadata &metadata, int32_t spec_id,
+                                                const IcebergDataFile &file) {
+	auto spec = metadata.partition_specs.find(spec_id);
+	if (spec == metadata.partition_specs.end()) {
+		throw SerializationException("Frozen Iceberg file references an unknown partition spec");
+	}
+	VaneIcebergPartition result;
+	result.spec_id = spec_id;
+	result.unpartitioned = spec->second.IsUnpartitioned();
+	for (auto &field : spec->second.fields) {
+		if (field.partition_field_id == 0 || field.partition_field_id > NumericLimits<int32_t>::Maximum()) {
+			throw SerializationException("Invalid frozen Iceberg partition field ID");
+		}
+		bool found = false;
+		for (auto &value : file.partition_info) {
+			if (value.field_id == field.partition_field_id) {
+				result.field_ids.push_back(static_cast<int32_t>(field.partition_field_id));
+				result.values.push_back(value.value);
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			if (field.transform != IcebergTransformType::VOID) {
+				throw SerializationException("Frozen Iceberg partition value is missing");
+			}
+			result.field_ids.push_back(static_cast<int32_t>(field.partition_field_id));
+			result.values.emplace_back();
+		}
+	}
+	result.Validate();
+	return result;
+}
+
+vector<VaneIcebergDeleteFile> VaneFreezeIcebergDeleteFiles(const IcebergMultiFileList &live) {
+	vector<VaneIcebergDeleteFile> result;
+	set<string> seen;
+	for (auto &entry : live.GetDeleteManifestEntries()) {
+		auto &data = entry.entry.data_file;
+		if (!StringUtil::CIEquals(data.file_format, "parquet") ||
+		    (data.content != IcebergManifestEntryContentType::POSITION_DELETES &&
+		     data.content != IcebergManifestEntryContentType::EQUALITY_DELETES)) {
+			throw NotImplementedException(
+			    "Frozen Iceberg transport requires Parquet position or equality delete files");
+		}
+		if (!seen.insert(data.file_path).second) {
+			throw SerializationException("Frozen Iceberg snapshot contains duplicate delete-file paths");
+		}
+		auto &manifest = live.GetManifestFileForEntry(entry, IcebergManifestContentType::DELETE);
+		VaneIcebergDeleteFile file;
+		file.path = data.file_path;
+		VaneValidateIcebergPath(file.path);
+		file.content = static_cast<uint8_t>(data.content);
+		file.sequence_number = entry.entry.GetSequenceNumber(manifest);
+		file.record_count = data.record_count;
+		file.file_size = data.file_size_in_bytes;
+		file.partition = VaneFreezeIcebergPartition(live.GetMetadata(), manifest.partition_spec_id, data);
+		file.referenced_data_file = data.referenced_data_file;
+		file.equality_ids = data.equality_ids;
+		result.push_back(std::move(file));
+	}
+	return result;
+}
+
+vector<VaneIcebergDeleteColumn>
+VaneFreezeIcebergDeleteColumns(const IcebergMultiFileList &live,
+                               const vector<MultiFileColumnDefinition> &selected_columns) {
+	map<int32_t, LogicalType> types;
+	for (auto &file : VaneFreezeIcebergDeleteFiles(live)) {
+		for (auto id : file.equality_ids) {
+			if (types.count(id)) {
+				continue;
+			}
+			LogicalType type = LogicalType::INVALID;
+			for (auto &column : selected_columns) {
+				if (!column.identifier.IsNull() && column.GetIdentifierFieldId() == id) {
+					type = column.type;
+					break;
+				}
+			}
+			if (type.id() == LogicalTypeId::INVALID) {
+				for (auto &schema : live.GetMetadata().GetSchemas()) {
+					for (auto &column : schema.second->columns) {
+						if (column->id != id) {
+							continue;
+						}
+						if (type.id() == LogicalTypeId::INVALID) {
+							type = column->type;
+						} else {
+							LogicalType common;
+							if (!LogicalType::TryGetMaxLogicalTypeUnchecked(type, column->type, common)) {
+								throw SerializationException("Incompatible historical equality delete field types");
+							}
+							type = std::move(common);
+						}
+					}
+				}
+			}
+			VaneIcebergDeleteColumn column {id, type};
+			column.Validate();
+			types.emplace(id, std::move(type));
+		}
+	}
+	vector<VaneIcebergDeleteColumn> result;
+	for (auto &entry : types) {
+		result.push_back({entry.first, entry.second});
+	}
+	return result;
+}
+
+shared_ptr<const VaneIcebergParsedDeletes> VaneReadIcebergDeletes(ClientContext &context,
+                                                                  const VaneIcebergDeleteFile &file,
+                                                                  const vector<VaneIcebergDeleteColumn> &columns) {
+	file.Validate(columns);
+	auto functions = IcebergFunctions::GetIcebergDeletesScanFunction(context);
+	auto function = functions.functions[0];
+	OpenFileInfo open(file.path);
+	function.function_info = make_shared_ptr<IcebergDeleteScanInfo>(open);
+	vector<Value> arguments {Value(file.path)};
+	named_parameter_map_t parameters;
+	vector<LogicalType> input_types, types;
+	vector<string> input_names, names;
+	TableFunctionRef ref;
+	TableFunctionBindInput bind_input(arguments, parameters, input_types, input_names, nullptr, nullptr, function, ref);
+	auto bind = function.bind(context, bind_input, types, names);
+	vector<column_t> ids;
+	for (idx_t index = 0; index < types.size(); index++) {
+		ids.push_back(index);
+	}
+	TableFunctionInitInput input(bind.get(), ids, {}, nullptr);
+	auto global = function.init_global(context, input);
+	ThreadContext thread(context);
+	ExecutionContext execution(context, thread, nullptr);
+	auto local = function.init_local(execution, input, global.get());
+	auto &reader = local->Cast<MultiFileLocalState>();
+	if (!reader.reader) {
+		throw InvalidInputException("Frozen Iceberg delete file has no Parquet reader");
+	}
+	map<int32_t, idx_t> physical;
+	for (idx_t index = 0; index < reader.reader->columns.size(); index++) {
+		auto &column = reader.reader->columns[index];
+		if (!column.identifier.IsNull() && !physical.emplace(column.GetIdentifierFieldId(), index).second) {
+			throw InvalidInputException("Frozen Iceberg delete file has duplicate field IDs");
+		}
+	}
+	vector<idx_t> selected;
+	vector<LogicalType> target_types;
+	vector<int32_t> required = file.content == 1 ? vector<int32_t> {MultiFileReader::DELETE_FILE_PATH_FIELD_ID,
+	                                                                MultiFileReader::DELETE_POS_FIELD_ID}
+	                                             : file.equality_ids;
+	for (auto id : required) {
+		auto found = physical.find(id);
+		if (found == physical.end()) {
+			throw InvalidInputException("Frozen Iceberg delete file is missing required field ID %d", id);
+		}
+		selected.push_back(found->second);
+		if (file.content == 1) {
+			auto type = id == MultiFileReader::DELETE_FILE_PATH_FIELD_ID ? LogicalType::VARCHAR : LogicalType::BIGINT;
+			if (types[found->second] != type) {
+				throw InvalidInputException("Frozen Iceberg position delete field has an invalid type");
+			}
+			target_types.push_back(type);
+		} else {
+			for (auto &column : columns) {
+				if (column.field_id == id) {
+					auto &source = types[found->second];
+					auto &target = column.type;
+					bool promotion = source.id() == LogicalTypeId::INTEGER && target.id() == LogicalTypeId::BIGINT;
+					if (source.id() == LogicalTypeId::DECIMAL && target.id() == LogicalTypeId::DECIMAL) {
+						promotion = DecimalType::GetScale(source) == DecimalType::GetScale(target) &&
+						            DecimalType::GetWidth(source) <= DecimalType::GetWidth(target);
+					}
+					if (source != target && !promotion) {
+						throw InvalidInputException(
+						    "Frozen Iceberg equality delete physical type does not match its field schema");
+					}
+					target_types.push_back(column.type);
+					break;
+				}
+			}
+		}
+	}
+	auto parsed = make_shared_ptr<VaneIcebergParsedDeletes>();
+	DataChunk chunk;
+	chunk.Initialize(context, types);
+	idx_t count = 0;
+	while (true) {
+		chunk.Reset();
+		TableFunctionInput function_input(bind.get(), local.get(), global.get());
+		function.function(context, function_input, chunk);
+		if (chunk.size() == 0) {
+			break;
+		}
+		for (idx_t row = 0; row < chunk.size(); row++) {
+			if (file.content == 1) {
+				auto path = chunk.GetValue(selected[0], row);
+				auto position = chunk.GetValue(selected[1], row);
+				if (path.IsNull() || position.IsNull() || position.GetValue<int64_t>() < 0) {
+					throw InvalidInputException(
+					    "Frozen Iceberg position delete requires a path and nonnegative position");
+				}
+				auto raw_path = path.GetValue<string>();
+				VaneValidateIcebergPath(raw_path);
+				if (!file.referenced_data_file.empty() && raw_path != file.referenced_data_file) {
+					throw InvalidInputException(
+					    "Frozen Iceberg position delete does not match its referenced data file");
+				}
+				parsed->data_paths.push_back(std::move(raw_path));
+				parsed->positions.push_back(position.GetValue<int64_t>());
+			} else {
+				vector<Value> values;
+				for (idx_t column = 0; column < selected.size(); column++) {
+					auto value = chunk.GetValue(selected[column], row);
+					values.push_back(value.IsNull() ? Value(target_types[column])
+					                                : value.DefaultCastAs(target_types[column]));
+				}
+				parsed->equality_buckets[VaneIcebergEqualityHash(values)].push_back(parsed->equality_rows.size());
+				parsed->equality_rows.push_back(std::move(values));
+			}
+		}
+		count += chunk.size();
+	}
+	if (count != static_cast<uint64_t>(file.record_count)) {
+		throw InvalidInputException("Frozen Iceberg delete record count does not match its manifest");
+	}
+	return parsed;
+}
+
