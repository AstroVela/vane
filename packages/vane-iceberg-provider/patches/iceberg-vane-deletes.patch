+namespace duckdb {
+
+idx_t VaneIcebergPositionFilter::Filter(row_t start, idx_t count, SelectionVector &selection) {
+	selection.Initialize(STANDARD_VECTOR_SIZE);
+	idx_t result = 0;
+	for (idx_t index = 0; index < count; index++) {
+		if (!positions.count(start + index)) {
+			selection.set_index(result++, index);
+		}
+	}
+	return result;
+}
