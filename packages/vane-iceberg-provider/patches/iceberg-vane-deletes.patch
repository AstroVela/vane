+void IcebergMultiFileList::ScanPositionalDeleteFile(const BoundIcebergManifestEntry &bound_entry, DataChunk &result,
+                                                    const vector<MultiFileColumnDefinition> &columns) const {
+	idx_t path_index = DConstants::INVALID_INDEX;
+	idx_t position_index = DConstants::INVALID_INDEX;
+	for (idx_t index = 0; index < columns.size(); index++) {
+		if (columns[index].identifier.IsNull()) {
+			continue;
+		}
+		auto id = columns[index].GetIdentifierFieldId();
+		if (id == MultiFileReader::DELETE_FILE_PATH_FIELD_ID) {
+			path_index = index;
+		} else if (id == MultiFileReader::DELETE_POS_FIELD_ID) {
+			position_index = index;
+		}
+	}
+	if (path_index >= result.ColumnCount() || position_index >= result.ColumnCount() ||
+	    result.data[path_index].GetType() != LogicalType::VARCHAR ||
+	    result.data[position_index].GetType() != LogicalType::BIGINT) {
+		throw InvalidInputException("Iceberg position delete requires field-ID-mapped string paths and long positions");
+	}
+	auto names = FlatVector::GetData<string_t>(result.data[path_index]);
+	auto row_ids = FlatVector::GetData<int64_t>(result.data[position_index]);
 
 	auto count = result.size();
 	if (count == 0) {
 		return;
+	}
+	for (idx_t i = 0; i < count; i++) {
+		if (!FlatVector::Validity(result.data[path_index]).RowIsValid(i) ||
+		    !FlatVector::Validity(result.data[position_index]).RowIsValid(i) || row_ids[i] < 0) {
+			throw InvalidInputException("Iceberg position delete requires a path and nonnegative position");
+		}
