+
+struct VaneIcebergDeleteFile {
+	string path;
+	uint8_t content = 0;
+	int64_t sequence_number = 0;
+	int64_t record_count = 0;
+	int64_t file_size = 0;
+	VaneIcebergPartition partition;
+	string referenced_data_file;
+	vector<int32_t> equality_ids;
+
+	void Serialize(Serializer &serializer) const;
+	static VaneIcebergDeleteFile Deserialize(Deserializer &deserializer);
+	void Validate(const vector<VaneIcebergDeleteColumn> &columns) const;
+	bool Equals(const VaneIcebergDeleteFile &other) const;
+	bool AppliesTo(const string &data_path, int64_t data_sequence, const VaneIcebergPartition &data_partition) const;
+};
+
+struct VaneIcebergParsedDeletes {
+	vector<string> data_paths;
+	vector<int64_t> positions;
+	vector<vector<Value>> equality_rows;
+	unordered_map<hash_t, vector<idx_t>> equality_buckets;
+};
+
+struct VaneIcebergPositionFilter : public DeleteFilter {
+	unordered_set<int64_t> positions;
+	idx_t Filter(row_t start, idx_t count, SelectionVector &selection) override;
+};
+
+hash_t VaneIcebergEqualityHash(const vector<Value> &values);
