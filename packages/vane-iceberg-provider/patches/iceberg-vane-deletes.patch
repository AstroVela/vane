+unique_ptr<DeleteFilter>
+IcebergMultiFileList::GetPositionalDeletesForFile(const string &file_path,
+                                                  optional_ptr<const BoundIcebergManifestEntry> data_entry) const {
 	lock_guard<mutex> guard(shared_state->delete_lock);
 	auto it = shared_state->positional_delete_data.find(file_path);
 	if (it != shared_state->positional_delete_data.end()) {
+		if (data_entry && it->second->type == IcebergDeleteType::POSITIONAL_DELETE) {
+			auto &data = static_cast<const IcebergPositionalDeleteData &>(*it->second);
+			auto filter = make_uniq<VaneIcebergPositionFilter>();
+			auto scoped = data.scoped_rows.find(file_path);
+			if (scoped == data.scoped_rows.end()) {
+				return std::move(filter);
+			}
+			auto &manifest = GetManifestFileForEntry(*data_entry, IcebergManifestContentType::DATA);
+			auto sequence = data_entry->entry.GetSequenceNumber(manifest);
+			auto partition =
+			    VaneFreezeIcebergPartition(GetMetadata(), manifest.partition_spec_id, data_entry->entry.data_file);
+			set<const IcebergManifestEntry *> seen;
+			for (auto &entry : data.entries) {
+				if (!seen.insert(&entry.entry).second) {
+					continue;
+				}
+				auto rows = scoped->second.find(&entry.entry);
+				if (rows == scoped->second.end()) {
+					continue;
+				}
+				auto &delete_manifest = GetManifestFileForEntry(entry, IcebergManifestContentType::DELETE);
+				VaneIcebergDeleteFile deleted;
+				deleted.content = 1;
+				deleted.sequence_number = entry.entry.GetSequenceNumber(delete_manifest);
+				deleted.partition =
+				    VaneFreezeIcebergPartition(GetMetadata(), delete_manifest.partition_spec_id, entry.entry.data_file);
+				deleted.referenced_data_file = entry.entry.data_file.referenced_data_file;
+				if (deleted.AppliesTo(file_path, sequence, partition)) {
+					for (auto row : rows->second) {
+						if (row < 0 || row >= data_entry->entry.data_file.record_count) {
+							throw InvalidInputException("Iceberg position delete exceeds the data-file record count");
+						}
+					}
+					filter->positions.insert(rows->second.begin(), rows->second.end());
+				}
+			}
+			return std::move(filter);
+		}
 		// There is delete data for this file, return it
 		return it->second->ToFilter();
 	}
