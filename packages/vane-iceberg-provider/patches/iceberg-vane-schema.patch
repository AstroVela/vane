+				// Keep legacy partition fields decodable after their source is
+				// dropped. A NULL target for a nonempty Avro struct is not a
+				// valid projection. These fields do not become output columns.
+				LogicalType historical_type = LogicalType::INVALID;
+				for (auto &schema_entry : metadata.GetSchemas()) {
+					unordered_map<uint64_t, ColumnIndex> historical_ids;
+					IcebergTableSchema::PopulateSourceIdMap(historical_ids, schema_entry.second->columns, nullptr);
+					auto historical = historical_ids.find(field.source_id);
+					if (historical == historical_ids.end()) {
+						continue;
+					}
+					auto &column =
+					    IcebergTableSchema::GetFromColumnIndex(schema_entry.second->columns, historical->second, 0);
+					if (historical_type.id() == LogicalTypeId::INVALID) {
+						historical_type = column.type;
+					} else {
+						LogicalType common_type;
+						if (!LogicalType::TryGetMaxLogicalTypeUnchecked(historical_type, column.type, common_type)) {
+							throw InvalidConfigurationException(
+							    "Incompatible historical types for partition source %llu", field.source_id);
+						}
+						historical_type = std::move(common_type);
+					}
+				}
+				if (historical_type.id() != LogicalTypeId::INVALID) {
+					partition_field_id_to_type.emplace(field.partition_field_id,
+					                                   field.transform.GetBoundsType(historical_type));
+				}
 				continue;
 			}
 			auto &column_id = it->second;
