+// Each file owns the values selected from its own manifest partition spec.
+// Neither catalog objects nor directory-derived partition values enter a bind.
+struct FrozenDataFile {
+	string path;
+	int32_t partition_spec_id = 0;
+	vector<int32_t> source_ids;
+	vector<Value> constants;
+
+	void Serialize(Serializer &serializer) const {
+		serializer.WriteProperty(1, "path", path);
+		serializer.WriteProperty(2, "partition_spec_id", partition_spec_id);
+		serializer.WriteProperty(3, "partition_source_ids", source_ids);
+		serializer.WriteProperty(4, "partition_constants", constants);
+	}
+	static FrozenDataFile Deserialize(Deserializer &deserializer) {
+		FrozenDataFile file;
+		file.path = deserializer.ReadProperty<string>(1, "path");
+		file.partition_spec_id = deserializer.ReadProperty<int32_t>(2, "partition_spec_id");
+		file.source_ids = deserializer.ReadProperty<vector<int32_t>>(3, "partition_source_ids");
+		file.constants = deserializer.ReadProperty<vector<Value>>(4, "partition_constants");
+		return file;
+	}
+};
+
+static vector<OpenFileInfo> FilePaths(const vector<FrozenDataFile> &files) {
+	vector<OpenFileInfo> paths;
+	for (auto &file : files) {
+		paths.emplace_back(file.path);
+	}
+	return paths;
+}
